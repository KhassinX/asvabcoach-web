---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign paginas = site.pages | where_exp: "p", "p.canonical_en" | sort: "url" %}
{%- for p in paginas %}
{%- if p.sitemap == false or p.robots == "noindex" %}{% continue %}{% endif %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ p.canonical_en }}"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.url }}{{ p.canonical_es }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ p.canonical_en }}"/>
    {%- if p.updated %}
    <lastmod>{{ p.updated | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
